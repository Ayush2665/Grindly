# Copy to .env.local and fill in. Never commit real values.
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (local: run `supabase start` and copy the printed keys)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay TEST keys only (must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 32+ random characters, shared with the pg_cron job that calls the settlement endpoint
SETTLEMENT_HMAC_SECRET=

# dev only. Must be false in production.
ENABLE_SIMULATED_WATCH=true
INTEREST_APY_BPS=600

# Phase 3 dev server. SESSION_SECRET is required in production (32+ characters).
SESSION_SECRET=
# GRINDLY_DB_DIR=memory   # throwaway database, used by the browser tests
